+def included_path(relative, *, distribution=False):
+    """Classify components at the kit root, never arbitrary textual prefixes."""
+    parts = relative.split('/')
+    if any(part in IGNORED for part in parts):
+        return False
+    if (len(parts) >= 4 and parts[:2] == ['docs', 'prompts-output']
+            and re.fullmatch(r'\[\d{2,}-\d+[a-z]?\]', parts[2])
+            and parts[3] in {'evidence', 'tmp'}):
+        return False
+    return not (distribution and relative in LOCAL_CONFIG_FILES)
+
 
